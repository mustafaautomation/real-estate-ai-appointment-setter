# Copy to .env.local. None of these values are live accounts.

# offline (default) when empty. When set, phrasing uses OpenAI and failures fall back to offline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=8000
LLM_RETRIES=2

APP_BASE_URL=http://localhost:3000

# memory (default) or sqlite
STORAGE_DRIVER=memory
DATABASE_PATH=./data/harborline.db

# Test secrets for local signature checks. Replace them when wiring a real provider.
TWILIO_AUTH_TOKEN=test-twilio-token
META_APP_SECRET=test-meta-secret
META_VERIFY_TOKEN=test-meta-verify

# Optional HMAC for the email inbound route. Empty disables that check (payload is still validated).
EMAIL_WEBHOOK_SECRET=

# memory (default), calcom, or google. calcom and google stay off unless you opt in.
CALENDAR_PROVIDER=memory
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_API_BASE=https://api.cal.com/v2
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_ACCESS_TOKEN=

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
BROKERAGE_TIMEZONE=America/Chicago
LOG_LEVEL=info
