{
  "name": "harborline-desk",
  "version": "1.0.0",
  "private": true,
  "description": "Personal demo of an omnichannel qualification and appointment desk. Synthetic listings. Fictional brokerage.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx evals/run.ts",
    "eval:openai": "EVAL_PROVIDER=openai tsx evals/run.ts",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3.3.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.4",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
